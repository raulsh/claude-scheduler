#!/bin/sh
# Configure claude-scheduler for this machine.
#
# The service must run as a real desktop user, because the claude CLI reads
# ~/.claude/.credentials.json and the aws CLI reads ~/.aws. Rather than ask
# the administrator to hand-edit a unit file, this script derives the user at
# install time and writes a systemd drop-in.
set -e

DROPIN_DIR=/etc/systemd/system/claude-scheduler.service.d
DROPIN=$DROPIN_DIR/10-user.conf
UNIT=claude-scheduler.service

# resolve_user prints the username the service should run as.
resolve_user() {
    # An existing drop-in wins, so reconfiguring never silently moves the
    # service to a different user's credentials.
    if [ -f "$DROPIN" ]; then
        existing=$(sed -n 's/^User=\(.*\)$/\1/p' "$DROPIN" | head -1)
        if [ -n "$existing" ] && id "$existing" >/dev/null 2>&1; then
            echo "$existing"
            return 0
        fi
    fi

    # The invoking user under sudo is the common case.
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ] && id "$SUDO_USER" >/dev/null 2>&1; then
        echo "$SUDO_USER"
        return 0
    fi

    # Fall back only when the choice is unambiguous: exactly one regular
    # human account. Guessing between several would point the service at the
    # wrong person's credentials.
    candidates=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { print $1 }' /etc/passwd)
    count=$(printf '%s\n' "$candidates" | grep -c . || true)
    if [ "$count" = "1" ]; then
        printf '%s\n' "$candidates"
        return 0
    fi

    return 1
}

write_dropin() {
    user=$1
    uid=$(id -u "$user")
    group=$(id -gn "$user")
    home=$(getent passwd "$user" | cut -d: -f6)

    mkdir -p "$DROPIN_DIR"

    # The claude CLI installs per-user and is not on the system PATH, so its
    # location is passed through the environment rather than by editing the
    # conffile (which would mark it locally modified for dpkg).
    claude_bin=""
    for candidate in "$home/.local/bin/claude" /usr/local/bin/claude /usr/bin/claude; do
        if [ -x "$candidate" ]; then
            claude_bin=$candidate
            break
        fi
    done

    cat > "$DROPIN" <<DROPIN_EOF
# Generated by the claude-scheduler package on $(date -Is).
# Re-run 'dpkg-reconfigure claude-scheduler' or edit this file to change the
# service user. Removing it reverts to the package default on next install.
[Service]
User=$user
Group=$group
Environment=HOME=$home
Environment=XDG_RUNTIME_DIR=/run/user/$uid
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus
DROPIN_EOF

    if [ -n "$claude_bin" ]; then
        echo "Environment=CLAUDE_SCHEDULER_CLAUDE_BIN=$claude_bin" >> "$DROPIN"
    fi

    chmod 0644 "$DROPIN"

    # StateDirectory and LogsDirectory create these, but doing it here means
    # ownership is right even if the service has not started yet.
    for dir in /var/lib/claude-scheduler /var/log/claude-scheduler; do
        mkdir -p "$dir"
        chown "$user:$group" "$dir"
        chmod 0750 "$dir"
    done

    echo "claude-scheduler: configured to run as $user (HOME=$home)"
    if [ -z "$claude_bin" ]; then
        echo "claude-scheduler: WARNING - the claude CLI was not found." >&2
        echo "  Install it, then: sudo systemctl restart claude-scheduler" >&2
    fi
}

case "$1" in
    configure)
        if user=$(resolve_user); then
            write_dropin "$user"
        else
            echo "claude-scheduler: could not determine which user to run as." >&2
            echo "  Create $DROPIN with:" >&2
            echo "    [Service]" >&2
            echo "    User=<your-user>" >&2
            echo "    Environment=HOME=/home/<your-user>" >&2
            echo "  then: sudo systemctl daemon-reload && sudo systemctl restart claude-scheduler" >&2
        fi

        systemctl daemon-reload >/dev/null 2>&1 || true

        if [ -d /run/systemd/system ]; then
            # deb-systemd-helper tracks the enable state across purges.
            if command -v deb-systemd-helper >/dev/null 2>&1; then
                deb-systemd-helper unmask "$UNIT" >/dev/null || true
                if deb-systemd-helper --quiet was-enabled "$UNIT"; then
                    deb-systemd-helper enable "$UNIT" >/dev/null || true
                else
                    deb-systemd-helper update-state "$UNIT" >/dev/null || true
                    systemctl enable "$UNIT" >/dev/null 2>&1 || true
                fi
            else
                systemctl enable "$UNIT" >/dev/null 2>&1 || true
            fi

            # restart, not start, so an upgrade picks up the new binary.
            systemctl restart "$UNIT" >/dev/null 2>&1 || \
                echo "claude-scheduler: start failed; see 'journalctl -u $UNIT -n 50'" >&2
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
