[Unit]
Description=Claude Scheduler - scheduled Claude Code tasks with dependency healthchecks
Documentation=https://github.com/raulsh/claude-scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/claude-scheduler serve --config /etc/claude-scheduler/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# State, logs and runtime, created and owned by the service user
# automatically. RuntimeDirectory gives /run/claude-scheduler for the API
# socket, and systemd removes it when the unit stops, which is also what
# clears a socket left behind by a SIGKILL.
StateDirectory=claude-scheduler
LogsDirectory=claude-scheduler
ConfigurationDirectory=claude-scheduler
RuntimeDirectory=claude-scheduler
RuntimeDirectoryMode=0750

# bind(2) creates the socket with 0777 minus the umask, and the daemon then
# chmods it to server.socket_mode. This bounds that window: connecting to a
# unix socket needs the write bit, and 0027 withholds it from everyone but
# the owner and group.
UMask=0027

# The service user, HOME, and session bus are machine-specific and are
# written by the package's postinst into:
#   /etc/systemd/system/claude-scheduler.service.d/10-user.conf
#
# ProtectHome and ProtectSystem=strict are deliberately NOT set: the whole
# purpose of this service is reading the user's ~/.claude credentials and
# ~/.aws SSO cache, and the claude CLI writes session state under $HOME.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
